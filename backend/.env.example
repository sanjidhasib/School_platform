NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://localhost:27017/schoolos
# In production: a long random value (32+ characters) or the server won't start.
JWT_SECRET=change_this_secret_in_production
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
# Only when the website and API share a parent domain, e.g. .school.edu.bd
COOKIE_DOMAIN=
GEMINI_API_KEY=your_gemini_api_key_here
# Change if Google retires the model (it retired gemini-2.5-flash for new keys)
GEMINI_MODEL=gemini-3.8-flash
# Comma-separated list of website addresses allowed to call the API
FRONTEND_URL=http://localhost:3000
UPLOAD_DIR=./uploads
TEXTBOOK_DIR=./storage/textbooks
MAX_FILE_SIZE_MB=5
# Number of proxies in front of the server (empty locally; 2 on Render behind Vercel)
TRUST_PROXY=
