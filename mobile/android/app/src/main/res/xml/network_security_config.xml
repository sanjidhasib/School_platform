<?xml version="1.0" encoding="utf-8"?>
<!--
  Allow both HTTP (for local testing with a laptop IP) and HTTPS (for hosted
  sites like Vercel or Render). Once you only use HTTPS hosting, you can
  tighten this to cleartextTrafficPermitted="false".
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
